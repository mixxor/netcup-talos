# .env.example - copy to .env and fill in. .env is gitignored.
#
# Both are written by netcup/00-auth.sh. The user id is NOT the customer number.
NETCUP_USER_ID=123456

# Offline refresh token from netcup/00-auth.sh. Expires after 30 unused days.
NETCUP_REFRESH_TOKEN=

# Source allowed to reach 22, 6443 and 50000.
# Leave empty to look the address up at apply time.
ADMIN_CIDR=
